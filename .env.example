# Google service account used to read/write Sheets — server-side only,
# never reaches the browser. See SPEC.md §3.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service account JSON key. Keep the \n
# escapes as literal two-character sequences (not real newlines); sheets.ts
# unescapes them at runtime.
GOOGLE_PRIVATE_KEY=

# Andrew Craig's workbook — for M1, use a TEST COPY of the live sheet
# (Drive > Make a copy, named "Andrew Craig TEST"), never the live one.
# Share the copy with the service account email above as Editor.
ANDREW_SPREADSHEET_ID=
